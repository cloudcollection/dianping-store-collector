{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "2.1.1",
  "description": "__MSG_extensionDescription__",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "debugger",
    "downloads",
    "sidePanel",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.dianping.com/*",
    "https://*.meituan.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.dianping.com/*",
        "https://*.meituan.com/*"
      ],
      "js": [
        "offer_parser.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "default_locale": "zh_CN"
}
