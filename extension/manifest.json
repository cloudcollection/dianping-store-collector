{
  "manifest_version": 3,
  "name": "店迹 - 大众点评店铺采集器",
  "version": "2.0.0",
  "description": "在用户可正常访问的页面中，顺序采集店铺、团购套餐与代金券，并支持固定队列和断点续采。",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "debugger",
    "downloads",
    "sidePanel",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.dianping.com/*",
    "https://*.meituan.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "店迹采集控制台",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.dianping.com/*",
        "https://*.meituan.com/*"
      ],
      "js": ["offer_parser.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
